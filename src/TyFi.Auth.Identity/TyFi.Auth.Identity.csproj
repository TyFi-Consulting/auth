<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TyFi.Auth.Identity</PackageId>
    <Description>Self-hosted, passwordless (email one-time-code) authentication: registration, login, refresh-token rotation with reuse detection, account lockout, and configurable role/permission-to-claims expansion. Access tokens are signed JWTs validated by the existing provider-agnostic TyFi.Auth.Jwt package with no changes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TyFi.Auth.Abstractions\TyFi.Auth.Abstractions.csproj" />
    <ProjectReference Include="..\TyFi.Auth.Identity.Abstractions\TyFi.Auth.Identity.Abstractions.csproj" />
  </ItemGroup>

</Project>
